{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/yell", "destination": "/index.html" },
    { "source": "/cli", "destination": "/index.html" },
    { "source": "/marquee", "destination": "/index.html" },
    { "source": "/away", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/audio/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(toasts|capstone|config).json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
